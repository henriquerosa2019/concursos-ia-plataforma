# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PLATAFORMA DE CONCURSOS IA & SUPABASE
# ==============================================================================
# Renomeie este arquivo para .env no ambiente local ou adicione estas variáveis
# no painel da Vercel (Settings ➔ Environment Variables).

# Supabase (PostgreSQL na Nuvem)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Provedores de Inteligência Artificial
GEMINI_API_KEY=sua-chave-google-gemini-aqui
OPENAI_API_KEY=sua-chave-openai-aqui
PREFERRED_PROVIDER=gemini

# Porta do Servidor Local
PORT=8095
